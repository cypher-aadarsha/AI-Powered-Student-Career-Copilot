# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database (matches docker-compose.yml's postgres service by default) ---
DATABASE_URL=postgresql+psycopg2://copilot:copilot@postgres:5432/career_copilot

# --- Auth ---
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- AI provider: "mock" runs fully offline, "llm" calls a real provider ---
AI_PROVIDER=mock
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- Resume storage (Phase 5) ---
RESUME_STORAGE_DIR=storage/resumes
RESUME_MAX_SIZE_MB=5
