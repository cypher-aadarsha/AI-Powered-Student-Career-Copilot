# Copy to .env.local for local (non-Docker) development. Never commit .env.local.
#
# Under Docker Compose, NEXT_PUBLIC_API_URL is NOT read from this file — it's
# inlined into the client bundle at image build time, so it's set instead via
# docker-compose.yml's frontend.build.args (see root docker-compose.yml).
# Changing it there requires `docker compose build frontend` (or `up --build`).

# Reached from the browser (login page, dashboard client calls, etc.)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Reached from Next.js server components/route handlers running *inside* the
# Docker network — leave unset for local (non-Docker) dev, where it falls
# back to NEXT_PUBLIC_API_URL above.
API_INTERNAL_URL=http://backend:8000
